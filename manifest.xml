<?xml version="1.0" encoding="UTF-8"?>
<!--
Standalone repo-tool manifest for building the Kaos distro rootfs
(hybris/kaos-configs/build-rootfs.sh) WITHOUT the full AOSP/LineageOS tree.

Confirmed (2026-09-25) that build-rootfs.sh's own dependency graph needs
only the projects listed below; nothing under the AOSP source tree itself
(Clang there is x86_64-only anyway; this manifest works on any host repo/
docker can run on, including native Linux arm64 and macOS/Docker Desktop,
Apple Silicon included).

See README.md in this same repo for setup and usage instructions.
-->
<manifest>
  <remote name="kamstartech" fetch="https://github.com/kamstartech/" />
  <remote name="mer-hybris" fetch="https://github.com/mer-hybris/" />

  <default remote="kamstartech" revision="main" sync-j="4" />

  <!-- build-rootfs.sh itself, plus kaos-*-chroot.sh build scripts it invokes -->
  <project name="kaos-configs" path="hybris/kaos-configs" revision="main" />

  <!-- kaos/scripts (KAOS_SCRIPTS_DIR) + Kaos Manager app source -->
  <project name="kaos" path="kaos" revision="main" />

  <!-- Sparse config tree (DROID_SPARSE_DIR) installed into the rootfs.
       Has its own submodule (droid-configs-device, pinned to our
       kamstartech fork of mer-hybris/droid-hal-configs); repo tool does
       not auto-init plain git submodules, run the submodule update command
       in the Usage note above after `repo sync`. -->
  <project name="droid-config-perseus" path="hybris/droid-configs" revision="master" />

  <!-- Frozen Android 15 header snapshot libhybris builds against -->
  <project name="android-headers" path="hybris/mw/android-headers" revision="main" />

  <!-- libhybris fork: gralloc/egl-hwcomposer/glesv/hwc2 compat layers -->
  <project name="libhybris" path="hybris/mw/libhybris/libhybris" revision="master" />

  <project name="libglibutil" path="hybris/mw/libglibutil" revision="master" />

  <!-- kamstartech fork, not upstream mer-hybris: carries the aidl3-vnd/
       aidl4-vnd /dev/vndbinder BINDER_VND_HEADER fix (2026-09-25). -->
  <project name="libgbinder" path="hybris/mw/libgbinder" revision="master" />

  <project name="libdroid" path="hybris/mw/libdroid" revision="noble" />

  <!-- wlroots fork tracking Droidian's ongoing development (0.17.4 + 6414
       commits); genuinely struct-incompatible with stock wlroots 0.17.1,
       see build-phoc-chroot.sh for why this matters. -->
  <project name="wlroots" path="hybris/mw/wlroots-hwcomposer" revision="noble" />
</manifest>
